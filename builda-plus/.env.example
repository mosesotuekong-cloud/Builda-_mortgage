# Copy this file to .env and fill it in. Comments must be on their own lines.

# Your OpenAI key and the model to use (a chat model your account can access)
OPENAI_API_KEY=
OPENAI_MODEL=

# Administrator connection: used only by "npm run migrate" and "npm run setup-demo"
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/builda

# The app's own connection. Pick any password here; "npm run migrate" applies it for you.
DATABASE_URL=postgres://builda_app:CHOOSE_A_PASSWORD@localhost:5432/builda

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

APP_BASE_URL=http://localhost:3000
PORT=3000

# Private demo online: a shared password (12+ characters) in front of everything. Required whenever
# APP_BASE_URL isn't this computer, because the demo sign-in lets anyone pick any account.
# See docs/private-demo-hosting.md.
DEMO_ACCESS_PASSWORD=

# Shown on the consent screen. Required in production; fine to leave as-is for a local demo.
RETENTION_MONTHS=12
JADA_CONTACT=Jo at JADA, replies within one working day

# Hard cap on AI tokens per discovery
MAX_TOKENS_PER_DISCOVERY=300000
