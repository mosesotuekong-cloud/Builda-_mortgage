# Copy this file to .env and fill it in. Comments must be on their own lines.

# Your OpenAI key and the model to use (a chat model your account can access)
OPENAI_API_KEY=
OPENAI_MODEL=

# Administrator connection: used only by "npm run migrate" and "npm run setup-demo"
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/builda

# The app's own connection. Pick any password here; "npm run migrate" applies it for you.
DATABASE_URL=postgres://builda_app:CHOOSE_A_PASSWORD@localhost:5432/builda

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

APP_BASE_URL=http://localhost:3000
PORT=3000

# We sell the discovery first. Engineering, implementation, impact and the knowledge editor are parked;
# set to "on" to bring them back (and to seed their demo data).
LATER_STAGES=

# Which interviewer runs main interviews: "knowledge" builds a connected understanding (activities, systems,
# handoffs, problems, each claim tied to a quote) and plans every question from it; "classic" goes stage by
# stage. Default: knowledge. Follow-ups, analysis and the report work the same either way. Needs migration
# 008 (npm run migrate); without it the server falls back to classic and says so in its log.
INTERVIEW_ENGINE=knowledge

# The sign-in password (12+ characters), set by whoever hosts BuildA+. The sign-in page asks for it before
# showing any account. The landing page, "Book a demo" and interview links stay public.
# Required whenever APP_BASE_URL isn't this computer. (The older DEMO_ACCESS_PASSWORD is still read if this
# is empty.) See docs/private-demo-hosting.md.
SIGNIN_PASSWORD=

# "Book a demo" emails through Brevo (brevo.com). Without both of the first two, requests are only listed
# in the JADA console. DEMO_REQUEST_FROM must be a sender verified in Brevo (e.g. BuildA+ <demo@jadasquad.com>).
# DEMO_REQUEST_TO is a comma-separated list; when empty it goes to the JADA team (see src/server.ts).
BREVO_API_KEY=
DEMO_REQUEST_FROM=
DEMO_REQUEST_TO=

# Shown on the consent screen. Required in production; fine to leave as-is for a local demo.
RETENTION_MONTHS=12
# The daily retention job (npm run retention) connects as its own role; npm run migrate sets this password.
RETENTION_DATABASE_URL=postgres://builda_retention:CHOOSE_A_PASSWORD@localhost:5432/builda
JADA_CONTACT=Jo at JADA, replies within one working day

# Hard cap on AI tokens per discovery
MAX_TOKENS_PER_DISCOVERY=300000

# On first start, a server with no JADA accounts creates the complete demo firm and its JADA account
# ("Demo Engineer (synthetic)"). Needs DATABASE_ADMIN_URL; never runs in production. Set to off to skip.
# DEMO_BOOTSTRAP=off
